# NVIDIA API key (embeddings only: /v1/embeddings, 1024-dim pgvector store)
NVIDIA_API_KEY=nvapi-...

# Google Gemini API key (chat only: Flash models via OpenAI-compatible endpoint)
# Get one free at https://aistudio.google.com/app/apikey — never commit it.
GOOGLE_API_KEY=AIza...

# Optional overrides — endpoints (tests point these at a local stub server)
# GOOGLE_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings

# Optional overrides — outbound deadline budgets (milliseconds)
# GOOGLE_CHAT_TIMEOUT_MS=45000     # per buffered attempt
# GOOGLE_CHAIN_DEADLINE_MS=55000   # entire fallback chain
# GOOGLE_STREAM_TTFB_MS=20000      # streaming time-to-first-byte
# GOOGLE_STREAM_TOTAL_MS=55000     # streaming overall
# NVIDIA_CHAT_TIMEOUT_MS=45000     # legacy fallback names, still honoured
# NVIDIA_CHAIN_DEADLINE_MS=55000
# NVIDIA_STREAM_TTFB_MS=20000
# NVIDIA_STREAM_TOTAL_MS=55000
# NVIDIA_EMBED_TIMEOUT_MS=10000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# REQUIRED — Postgres connection string used by the auth layer
# (lib/db/userQuery.ts talks directly to Postgres via `pg`).
# Use Supabase's *transaction pooler* URI (port 6543) for serverless deploys:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# REQUIRED — HS256 signing secret for session JWTs (middleware.ts + lib/auth.ts).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional: Redis URL for distributed rate limiting (falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# Whether to trust x-forwarded-for / x-real-ip headers when identifying clients
# for anonymous rate limits. Leave unset (or "1") on Vercel/behind a trusted
# proxy; set to "0" when self-hosting without a trusted proxy so spoofed
# forwarding headers cannot bypass per-IP limits (clients then share one bucket).
TRUST_PROXY=1

# Optional: Sentry DSN. Leave unset to disable Sentry entirely.
# SENTRY_DSN=https://...@sentry.io/...

# Required for /admin. The server compares submitted passwords against this
# value with a constant-time comparison, then sets an HTTP-only cookie
# containing an HMAC token keyed by this secret (lib/adminAuth.ts).
# Rotating it invalidates all existing admin sessions.
ADMIN_PASSWORD=please-change-me

# Pino log level. One of: trace | debug | info | warn | error | fatal
PINO_LOG_LEVEL=info

# Public origin used to construct shareable URLs (e.g. https://hukm.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
