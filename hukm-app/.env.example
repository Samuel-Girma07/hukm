# NVIDIA API key (used for both /v1/embeddings and /v1/chat/completions)
NVIDIA_API_KEY=nvapi-...

# Optional overrides — endpoints (tests point these at a local stub server)
# NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings

# Optional overrides — outbound deadline budgets (milliseconds)
# NVIDIA_CHAT_TIMEOUT_MS=45000     # per buffered attempt
# NVIDIA_CHAIN_DEADLINE_MS=55000   # entire fallback chain
# NVIDIA_STREAM_TTFB_MS=20000      # streaming time-to-first-byte
# NVIDIA_STREAM_TOTAL_MS=55000     # streaming overall
# NVIDIA_EMBED_TIMEOUT_MS=10000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: Redis URL for distributed rate limiting (falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# Optional: Sentry DSN. Leave unset to disable Sentry entirely.
# SENTRY_DSN=https://...@sentry.io/...

# Required for /admin. Stored as plaintext in env; the page hashes it client-side
# and compares against the SHA-256 of this value.
ADMIN_PASSWORD=please-change-me

# Pino log level. One of: trace | debug | info | warn | error | fatal
PINO_LOG_LEVEL=info

# Public origin used to construct shareable URLs (e.g. https://hukm.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
